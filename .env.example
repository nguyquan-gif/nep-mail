# Copy to .env. Generate each secret independently (openssl rand -hex 32).
APP_ORIGIN=http://localhost:3000
PORT=3000
DATA_DIR=./data
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-64-random-hex-characters
UNSUBSCRIBE_SECRET=replace-with-another-64-random-hex-secret
# Safe default: sends test messages only to the local capture mailbox.
LIVE_SEND=false
CAPTURE_MODE=true
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=hello@example.invalid
# Direct Internet deployment: see docs/SELF_HOST.md before enabling.
# APP_ORIGIN=https://mail.your-domain.vn
# PUBLIC_UNSUBSCRIBE_ORIGIN=https://mail.your-domain.vn
# MAIL_DOMAIN=your-domain.vn
# MAIL_HOSTNAME=mail.your-domain.vn
# DKIM_SELECTOR=nep
# DKIM_PRIVATE_KEY_FILE=/run/secrets/dkim.key
# Bounce mailbox over IMAP. Leave unset to ingest bounces only through
# POST /api/v1/bounces or scripts/bounces.mjs.
# BOUNCE_IMAP_HOST=imap.example.vn
# BOUNCE_IMAP_PORT=993
# BOUNCE_IMAP_SECURE=true
# BOUNCE_IMAP_USER=bounce@example.vn
# BOUNCE_IMAP_PASS=replace-with-an-app-password
# BOUNCE_IMAP_MAILBOX=INBOX
# BOUNCE_IMAP_INTERVAL=60
# Limit suppression to one workspace id; empty means the whole instance.
# BOUNCE_WORKSPACE=

# HTTP relay: send without port 25, receive bounces by webhook.
# Supported providers: brevo. See docs/DELIVERABILITY.md.
# RELAY_PROVIDER=brevo
# RELAY_API_KEY=xkeysib-...
# MAIL_FROM_NAME=Nếp Mail
# The webhook URL is /api/v1/webhooks/<provider>?token=<RELAY_WEBHOOK_SECRET>
# RELAY_WEBHOOK_SECRET=replace-with-32-random-characters
