{
  "name": "nep-mail",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:selfhost": "vite build --config vite.selfhost.config.ts",
    "start:selfhost": "node --env-file-if-exists=.env selfhost/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "format:check": "prettier --check src selfhost tests db docs scripts *.md vite.selfhost.config.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "zod": "3.25.76",
    "nodemailer": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/nodemailer": "8.0.2",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "prettier": "3.9.10",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10"
  }
}
