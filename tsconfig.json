{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "selfhost/**/*.ts",
    "selfhost/**/*.tsx",
    "tests/**/*.ts",
    "db/**/*.ts",
    "drizzle.config.ts",
    "vite.selfhost.config.ts"
  ],
  "exclude": [
    "node_modules",
    "selfhost-dist"
  ]
}
